# Copie para .env (docker-compose e os adapters leem estas variáveis)

# Postgres (modelo relacional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=poc
POSTGRES_PASSWORD=poc
POSTGRES_DB=poc

# MongoDB (modelo documento)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=poc

# Neo4j (property graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pocpocpoc

# Oxigraph (RDF / SPARQL)
OXIGRAPH_URL=http://localhost:7878

# Web
WEB_API_PORT=8787
