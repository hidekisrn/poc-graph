{
  "name": "poc-graph",
  "version": "0.1.0",
  "private": true,
  "description": "DDIA Cap.2 (Data Models & Query Languages) aplicado: um dataset canônico em 5 modelos de dados",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "seed": "tsx apps/cli/index.ts seed",
    "ask": "tsx apps/cli/index.ts ask",
    "cli": "tsx apps/cli/index.ts",
    "web": "npm run dev -w @poc/web",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@poc/core": "*",
    "@poc/dataset": "*",
    "@poc/registry": "*",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
